# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API). The anon/publishable key is safe in the browser
# because row-level security protects every table. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web push for the rest-timer alert (VAPID). Generate once:
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log(k.publicKey,k.privateKey)"
# The public key is sent to the browser; the private key is a secret and stays on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app
